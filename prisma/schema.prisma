generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberType {
  NEW
  ACTIVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum RoleCode {
  MEMBER
  COMMITTEE_LEADER
  ADMIN
}

enum CommitteeStatus {
  ACTIVE
  INACTIVE
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum ActivityStatus {
  DRAFT
  OPEN
  CLOSED
  PROCESSED
  CANCELLED
}

enum ActivityType {
  GENERAL
  SPORTS
  TALK
  WORKSHOP
  SOCIAL
  OTHER
}

enum AttendanceMode {
  OPEN_LINK
}

enum ApprovalMode {
  AUTO
  MANUAL
}

enum AttendanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceSource {
  QR
  LINK
  ADMIN
  IMPORT
  MICROSOFT_FORMS
}

enum PointTransactionType {
  ACTIVITY
  MANUAL_ADJUSTMENT
  BONUS
  PENALTY
  REVERSAL
}

enum AuthProvider {
  EMAIL_OTP
  MICROSOFT_ENTRA
}

enum AuthChallengeKind {
  OTP
  MAGIC_LINK
}

enum CommitteeCreditStrategy {
  FULL_CREDIT
  FRACTIONAL_CREDIT
}

enum BadgeType {
  STREAK
  POINTS
  TOP
  MVP
  LEADER
}

model Member {
  id                 String       @id @default(cuid())
  fullName           String
  institutionalEmail String       @unique
  memberType         MemberType   @default(NEW)
  status             MemberStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  identityAccounts    IdentityAccount[]
  roles               MemberRole[]
  committees          MemberCommittee[]
  attendances         Attendance[]
  approvedAttendances Attendance[]       @relation("AttendanceApprovedBy")
  pointTransactions   PointTransaction[]
  createdActivities   Activity[]         @relation("ActivityCreatedBy")
  createdPointTx      PointTransaction[] @relation("PointTransactionCreatedBy")
  sessions            Session[]
  auditLogs           AuditLog[]
  badges              MemberBadge[]
  updatedConfigs      AppConfig[]        @relation("AppConfigUpdatedBy")
  importJobs          ImportJob[]

  @@index([status, memberType])
  @@index([fullName])
}

model IdentityAccount {
  id             String       @id @default(cuid())
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  provider       AuthProvider
  providerUserId String
  microsoftOid   String?
  microsoftTid   String?
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([memberId])
}

model MemberRole {
  id          String     @id @default(cuid())
  memberId    String
  member      Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  role        RoleCode
  committeeId String?
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())

  @@index([memberId, role])
  @@index([role])
}

model Committee {
  id        String          @id @default(cuid())
  name      String
  slug      String          @unique
  status    CommitteeStatus @default(ACTIVE)
  color     String          @default("#1e3a5f")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  memberships MemberCommittee[]
  scores      CommitteeActivityScore[]
  leaderRoles MemberRole[]
  activities  Activity[]

  @@index([status])
}

model MemberCommittee {
  id          String    @id @default(cuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  committeeId String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([committeeId, isActive])
  @@index([memberId, isActive])
}

model Season {
  id        String       @id @default(cuid())
  name      String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    SeasonStatus @default(UPCOMING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  activities        Activity[]
  pointTransactions PointTransaction[]
  hallOfFame        HallOfFameSeason?

  @@index([status])
}

model Activity {
  id                      String         @id @default(cuid())
  publicId                String         @unique
  seasonId                String
  season                  Season         @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  name                    String
  description             String?
  activityType            ActivityType   @default(GENERAL)
  startsAt                DateTime
  registrationStart       DateTime
  registrationEnd         DateTime
  individualPoints        Int
  attendanceMode          AttendanceMode @default(OPEN_LINK)
  approvalMode            ApprovalMode   @default(AUTO)
  status                  ActivityStatus @default(DRAFT)
  committeeId             String?
  committee               Committee?     @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  needsApproval           Boolean        @default(false)
  requireAttendanceToken  Boolean        @default(false)
  attendanceTokenHash     String?
  createdById             String
  createdBy               Member         @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  attendances       Attendance[]
  scores            CommitteeActivityScore[]
  pointTransactions PointTransaction[]
  publicIdHistory   ActivityPublicIdHistory[]

  @@index([seasonId, status])
  @@index([startsAt])
  @@index([status, registrationStart, registrationEnd])
  @@index([needsApproval, status])
  @@index([committeeId])
}

model ActivityPublicIdHistory {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  publicId   String
  retiredAt  DateTime @default(now())

  @@index([activityId])
  @@index([publicId])
}

model Attendance {
  id           String           @id @default(cuid())
  activityId   String
  activity     Activity         @relation(fields: [activityId], references: [id], onDelete: Restrict)
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  status       AttendanceStatus @default(PENDING)
  registeredAt DateTime         @default(now())
  approvedAt   DateTime?
  approvedById String?
  approvedBy   Member?          @relation("AttendanceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  source       AttendanceSource @default(LINK)
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  pointTransactions PointTransaction[]

  @@unique([activityId, memberId])
  @@index([memberId])
  @@index([activityId, status])
}

model PointTransaction {
  id           String                @id @default(cuid())
  memberId     String
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Restrict)
  seasonId     String
  season       Season                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  activityId   String?
  activity     Activity?             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  attendanceId String?
  attendance   Attendance?           @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  points       Int
  type         PointTransactionType
  reason       String
  createdById  String?
  createdBy    Member?               @relation("PointTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now())
  reversalOfId String?               @unique
  reversalOf   PointTransaction?     @relation("PointReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   PointTransaction?     @relation("PointReversal")

  @@index([seasonId, memberId])
  @@index([seasonId, createdAt])
  @@index([memberId, createdAt])
  @@index([activityId])
  @@index([attendanceId])
}

model CommitteeActivityScore {
  id                  String                   @id @default(cuid())
  committeeId         String
  committee           Committee                @relation(fields: [committeeId], references: [id], onDelete: Restrict)
  activityId          String
  activity            Activity                 @relation(fields: [activityId], references: [id], onDelete: Restrict)
  seasonId            String
  eligibleMemberCount Int
  attendeeCredit      Decimal                  @db.Decimal(12, 6)
  participationRate   Decimal                  @db.Decimal(12, 6)
  creditStrategy      CommitteeCreditStrategy
  frozen              Boolean                  @default(false)
  computedAt          DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([committeeId, activityId])
  @@index([seasonId, committeeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      Member?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

model AppConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Member?  @relation("AppConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuthChallenge {
  id          String            @id @default(cuid())
  email       String
  kind        AuthChallengeKind @default(OTP)
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int               @default(0)
  maxAttempts Int               @default(5)
  ip          String?
  createdAt   DateTime          @default(now())

  @@index([email, createdAt])
  @@index([email, kind, consumedAt])
  @@index([ip, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  type        BadgeType
  createdAt   DateTime    @default(now())
  members     MemberBadge[]
}

model MemberBadge {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  awardedAt DateTime @default(now())
  seasonId  String?
  periodKey String   @default("")

  @@unique([memberId, badgeId, seasonId, periodKey])
}

model HallOfFameSeason {
  id                String   @id @default(cuid())
  seasonId          String   @unique
  season            Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  activeWinnerId    String?
  newWinnerId       String?
  committeeWinnerId String?
  top3Active        Json
  top3New           Json
  top3Committees    Json
  stats             Json
  createdAt         DateTime @default(now())
}

model ImportJob {
  id          String   @id @default(cuid())
  type        String
  status      String
  filename    String
  summary     Json?
  createdById String
  createdBy   Member   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
