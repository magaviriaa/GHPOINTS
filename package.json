{
  "name": "ghpoints",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma contract emit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && oxlint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma contract emit",
    "db:init": "prisma db init",
    "db:migrate": "prisma db update && npm run db:constraints && prisma db verify",
    "db:deploy": "prisma migrate && npm run db:constraints && prisma db verify",
    "db:constraints": "tsx src/prisma/apply-constraints.ts",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:prune": "tsx --conditions=react-server prisma/prune.ts",
    "db:reset": "prisma db init --yes && npm run db:constraints && prisma db verify && npm run db:seed",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "next": "16.3.2",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@oxlint/plugins": "^1.80.0",
    "@playwright/test": "^1.62.1",
    "@prisma/cli-engine": "0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "oxlint": "^1.80.0",
    "prisma": "8.0.0-rc.7",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.4",
    "lodash": "4.18.1",
    "valibot": "1.4.2"
  }
}
