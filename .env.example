# Local Homebrew (current OS user, no password):
# DATABASE_URL="postgresql://USER@localhost:5432/ghpoints"
# Docker Compose (docker compose up -d):
DATABASE_URL="postgresql://ghpoints:ghpoints@localhost:5432/ghpoints"
SESSION_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
INSTITUTIONAL_EMAIL_DOMAINS="eafit.edu.co"
APP_TIMEZONE="America/Bogota"
# Fija el proceso en UTC; APP_TIMEZONE es solo la zona de presentación.
TZ="UTC"
EMAIL_FROM="GH Points <noreply@localhost>"
RESEND_API_KEY=""
OTP_TTL_SECONDS="600"
OTP_FIXED_CODE="123456"
# Rate limit del login por ventana de 15 minutos. Súbelos solo en dev/E2E.
OTP_MAX_PER_EMAIL="5"
OTP_MAX_PER_IP="12"
# Optional. Falls back to SESSION_SECRET for signing magic-link tokens.
MAGIC_LINK_SECRET=""
IMPORT_SECRET=""

# Auth providers: comma-separated. email_otp is always available as fallback.
# Add entra only after filling the Entra variables below.
AUTH_PROVIDERS="email_otp"

# Optional Microsoft Entra ID / OIDC. Leave empty to boot OTP-only.
# Redirect URI to register: {APP_URL}/api/auth/entra/callback
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
ENTRA_TENANT_ID=""
# Required when ENTRA_TENANT_ID is "organizations" or "common". Comma-separated tids.
ENTRA_ALLOWED_TIDS=""

# Optional incoming Teams webhook. Unset = no-op.
TEAMS_WEBHOOK_URL=""
